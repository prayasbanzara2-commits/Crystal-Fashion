# Crystal Fashion Website - Environment Variables
# Copy this file to .env.local and fill in your values
# IMPORTANT: Never commit .env.local to version control!

# Email Configuration (Optional - for contact form)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Formspree Configuration (Alternative email service)
REACT_APP_FORMSPREE_ID=

# Google Maps API Key (Optional - for advanced map features)
REACT_APP_GOOGLE_MAPS_API_KEY=

# Business Information
REACT_APP_BUSINESS_NAME=Crystal Fashion
REACT_APP_BUSINESS_EMAIL=crystlfashionnp@gmail.com
REACT_APP_BUSINESS_PHONE=+977 9704828728
REACT_APP_BUSINESS_LOCATION=Kathmandu, Nepal

# Social Media URLs
REACT_APP_INSTAGRAM_URL=https://www.instagram.com/crystalfashion_np/?hl=en
REACT_APP_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61577121806289
REACT_APP_PINTEREST_URL=https://www.pinterest.com/crystlfashionnp/
REACT_APP_WHATSAPP_URL=https://wa.me/9779704828728

# Analytics (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=

# API Configuration
REACT_APP_API_URL=https://your-domain.com
REACT_APP_ENVIRONMENT=production

# Security
REACT_APP_MAX_INPUT_LENGTH=500
REACT_APP_SESSION_TIMEOUT=3600000
